{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "host": "127.0.0.1",
            "env": {
                "FLASK_APP": "src/flask-app/api/routes",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "0",
                "CELERY_BROKER_URL": "redis://localhost:6379/0"
            },
            "envFile": "${workspaceFolder}/.env.fake",
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--host=0.0.0.0",
                "--port=8080"
            ]
        },
        {
            "name": "Local: Celery",
            "type": "python",
            "request": "launch",
            "module": "celery",
            "env": {
                "CELERY_BROKER_URL": "redis://localhost:6379/0"
            },
            "envFile": "${workspaceFolder}/.env.fake",
            "cwd": "${workspaceFolder}/src",
            "args": [
                "-A",
                "flask-app.worker.tasks",
                "worker",
                "-P",
                "solo",
                "--loglevel=info"
            ]
        },
        {
            "name": "DevContainer: Flask API",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "src.flask-app.api.routes:FLASK",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "REDIS_URL": "redis://redis:6379/0",
                "CELERY_BROKER_URL": "redis://redis:6379/0",
                "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=8080",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "DevContainer: Flask API (with debugpy)",
            "type": "python",
            "request": "launch",
            "module": "debugpy",
            "args": [
                "--listen",
                "0.0.0.0:5678",
                "-m",
                "flask",
                "run",
                "--host=0.0.0.0",
                "--port=8080",
                "--reload"
            ],
            "env": {
                "FLASK_APP": "src.flask-app.api.routes:FLASK",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "REDIS_URL": "redis://redis:6379/0",
                "CELERY_BROKER_URL": "redis://redis:6379/0",
                "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
            },
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "DevContainer: Celery Worker",
            "type": "python",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A",
                "src.flask-app.worker.tasks",
                "worker",
                "--loglevel=info",
                "--pool=solo"
            ],
            "env": {
                "REDIS_URL": "redis://redis:6379/0",
                "CELERY_BROKER_URL": "redis://redis:6379/0",
                "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
            },
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "DevContainer: Full Stack (Flask + Celery)",
            "configurations": ["DevContainer: Flask API", "DevContainer: Celery Worker"],
            "stopAll": true,
            "preLaunchTask": "ensure-services"
        }
    ]
}